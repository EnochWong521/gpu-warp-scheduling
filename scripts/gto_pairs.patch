+// Use decoded operation classes. Generic ALU on Volta includes moves, NOP
+// and synchronization, so it is not sufficient evidence of arithmetic.
+static const char *pair_class(const warp_inst_t &inst) {
+  if (inst.isatomic()) return "other";
+  if (inst.is_load()) return "load";
+  if (inst.is_store()) return "store";
+  switch (inst.op) {
+    case SP_OP:
+    case DP_OP:
+    case INTP_OP:
+    case SFU_OP:
+    case ALU_SFU_OP:
+    case TENSOR_CORE_OP:
+    case SPECIALIZED_UNIT_3_OP:  // SM7_QV100 tensor operations
+      return "arithmetic";
+    case ALU_OP:
+    case BRANCH_OP:
+    case BARRIER_OP:
+    case MEMORY_BARRIER_OP:
+    case CALL_OPS:
+    case RET_OPS:
+    case EXIT_OPS:
+    case SPECIALIZED_UNIT_1_OP:  // SM7_QV100 branch unit
+      return "other";
+    default:
+      return "unclassified";
+  }
+}
