+void gto_scheduler::do_on_warp_issued(
+    unsigned warp_id, unsigned num_issued,
+    const std::vector<shd_warp_t *>::const_iterator &prioritized_iter) {
+  scheduler_unit::do_on_warp_issued(warp_id, num_issued, prioritized_iter);
+  if (!m_limit_greedy_priority || num_issued != 1) return;
+
+  // Count each successful scheduler cycle once, even with dual issue.
+  const unsigned dynamic_id = warp(warp_id).get_dynamic_warp_id();
+  if (m_issue_streak != 0 && dynamic_id == m_last_issued_dynamic_id) {
+    if (m_issue_streak < GREEDY_ISSUE_LIMIT) ++m_issue_streak;
+  } else {
+    if (m_greedy_limit_active) ++m_stats->gto_limit_other_warp_cycles;
+    m_last_issued_dynamic_id = dynamic_id;
+    m_issue_streak = 1;
+  }
