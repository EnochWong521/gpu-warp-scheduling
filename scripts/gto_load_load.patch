+// GTO puts the last-issued slot first. Require the same dynamic warp and
+// a dispatchable first instruction before changing this cycle's ordering.
+shd_warp_t *scheduler_unit::promote_older_load() {
+  auto &order = m_next_cycle_prioritized_warps;
+  if (!probe_has_previous || order.empty()) return nullptr;
+  auto *greedy = order.front();
+  if (!greedy || greedy->done_exit() ||
+      greedy->get_dynamic_warp_id() != probe_previous ||
+      probe_next(*greedy) != shd_warp_t::probe_state::eligible ||
+      strcmp(pair_class(*greedy->ibuffer_next_inst()), "load") != 0)
+    return nullptr;
+
+  auto oldest = order.end();
+  unsigned age_bound = probe_previous;
+  unsigned unknown_bound = probe_previous;
+  for (auto it = order.begin() + 1; it != order.end(); ++it) {
+    auto *w = *it;
+    if (!w || w->done_exit() || w->get_dynamic_warp_id() >= age_bound) continue;
+    auto state = probe_next(*w);
+    if (state == shd_warp_t::probe_state::unknown)
+      unknown_bound = std::min(unknown_bound, w->get_dynamic_warp_id());
+    if (state == shd_warp_t::probe_state::eligible) {
+      oldest = it;
+      age_bound = w->get_dynamic_warp_id();
+    }
+  }
+  if (oldest == order.end() || unknown_bound < age_bound ||
+      strcmp(pair_class(*(*oldest)->ibuffer_next_inst()), "load") != 0)
+    return nullptr;
+  std::rotate(order.begin(), oldest, oldest + 1);
+  return order.front();
+}
