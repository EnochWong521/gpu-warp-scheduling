+// waiting() may mutate barrier, cache, sleep and wait-group state.
+shd_warp_t::probe_state shd_warp_t::probe_wait() const {
+  if (functional_done() || m_shader->warp_waiting_at_barrier(m_warp_id) ||
+      m_n_atomic || m_waiting_ldgsts) return probe_state::blocked;
+  if (m_membar || m_waiting_tma_bulk_group || m_waiting_gmma_group ||
+      m_nanosleep_until) return probe_state::unknown;
+  for (unsigned lane = 0; lane < MAX_WARP_SIZE; ++lane)
+    if (get_mbarrier_waiting(lane)) return probe_state::unknown;
+  return probe_state::eligible;
+}
