+// Route and test the same dispatch register for actual and hypothetical issue.
+register_set *scheduler_unit::issue_port(op_type op, exec_unit_type_t previous,
+                                         exec_unit_type_t &unit) const {
+  const auto *cfg = m_shader->m_config;
+  register_set *port;
+  unsigned units;
+  if (op == LOAD_OP || op == STORE_OP || op == MEMORY_BARRIER_OP ||
+      op == TENSOR_CORE_LOAD_OP || op == TENSOR_CORE_STORE_OP || op == FENCE_OP ||
+      op == SYNCS_OP || op == TMA_OP || op == ARRIVES_OP || op == STAS_OP) {
+    unit = MEM;
+    port = m_mem_out;
+    units = 1;  // Memory issue is gated by the register set.
+  } else if (op >= SPEC_UNIT_START_ID) {
+    unsigned index = op - SPEC_UNIT_START_ID;
+    assert(index < cfg->m_specialized_unit.size());
+    unit = SPECIALIZED;
+    port = m_spec_cores_out[index];
+    units = cfg->m_specialized_unit[index].num_units;
+  } else if (op == TENSOR_CORE_OP) {
+    unit = TENSOR;
+    port = m_tensor_core_out;
+    units = cfg->gpgpu_num_tensor_core_units;
+  } else if (op == SFU_OP || (op == DP_OP && !cfg->gpgpu_num_dp_units)) {
+    unit = SFU;
+    port = m_sfu_out;
+    units = cfg->gpgpu_num_sfu_units;
+  } else if (op == DP_OP) {
+    unit = DP;
+    port = m_dp_out;
+    units = cfg->gpgpu_num_dp_units;
+  } else if (op != SP_OP && cfg->gpgpu_num_int_units) {
+    unit = INT;
+    port = m_int_out;
+    units = cfg->gpgpu_num_int_units;
+  } else {
+    unit = SP;
+    port = m_sp_out;
+    units = cfg->gpgpu_num_sp_units;
+  }
+  if (!units || (cfg->gpgpu_dual_issue_diff_exec_units && previous == unit))
+    return nullptr;
+  return port->has_free(cfg->sub_core_model, m_id) ? port : nullptr;
+}
+
+shd_warp_t::probe_state scheduler_unit::probe_next(shd_warp_t &w) const {
+  using state = shd_warp_t::probe_state;
+  if (w.ibuffer_empty() || !w.ibuffer_next_valid()) return state::blocked;
+  const warp_inst_t *inst = w.ibuffer_next_inst();
+  if (!inst) return state::blocked;
+  unsigned wid = w.get_warp_id();
+  unsigned pc, rpc;
+  m_shader->get_pdom_stack_top_info(wid, inst, &pc, &rpc);
+  if (pc != inst->pc || m_scoreboard->checkCollision(wid, inst))
+    return state::blocked;
+  exec_unit_type_t unit;
+  if (!issue_port(inst->op, NONE, unit)) return state::blocked;
+  auto wait = w.probe_wait();
+  if (wait != state::eligible) return wait;
+  if (inst->m_is_cdp || inst->is_syncs_try_wait()) return state::unknown;
+  return state::eligible;
+}
+
+void scheduler_unit::observe_first_issue(shd_warp_t &chosen,
+                                         const warp_inst_t &inst) {
+  unsigned id = chosen.get_dynamic_warp_id();
+  auto pending = probe_pending.find(id);
+  if (pending != probe_pending.end()) {
+    ++m_stats->probe_wait_histogram[pending->second];
+    probe_pending.erase(pending);
+  }
+  if (probe_has_previous && probe_previous == id) {
+    ++m_stats->probe_repeats;
+    // TRYWAIT and CDP can change state before the issue call.
+    bool unknown = inst.m_is_cdp || inst.is_syncs_try_wait();
+    bool bypassed = false;
+    if (!unknown) {
+      for (auto *w : m_supervised_warps) {
+        if (!w || w->done_exit() || w->get_dynamic_warp_id() >= id) continue;
+        auto result = probe_next(*w);
+        if (result == shd_warp_t::probe_state::unknown) unknown = true;
+        if (result == shd_warp_t::probe_state::eligible) {
+          bypassed = true;
+          ++probe_pending[w->get_dynamic_warp_id()];
+          ++m_stats->probe_opportunities;
+        }
+      }
+    }
+    if (unknown) ++m_stats->probe_unknown_cycles;
+    if (bypassed) ++m_stats->probe_bypasses;
+  }
+  probe_has_previous = true;
+  probe_previous = id;
+}
